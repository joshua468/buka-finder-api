# Copy to .env and adjust. Never commit real .env values.
DATABASE_URL=postgres://postgres:postgres@localhost:5432/fooddelivery?sslmode=disable
PORT=8000

# Rate limiting (all optional, these are the defaults)
RATE_LIMIT_ENABLED=true
RATE_LIMIT_LIMIT=100
RATE_LIMIT_BURST=150

# Pagination defaults
PAGINATION_DEFAULT_LIMIT=20
PAGINATION_MAX_LIMIT=100

# Comma-separated allow list; never "*"
CORS_ORIGINS=http://localhost:5173

# Path to built consumer (default: ./frontend/dist relative to working dir or exe dir)
# FRONTEND_DIST=C:/Users/joshu/Desktop/API/frontend/dist